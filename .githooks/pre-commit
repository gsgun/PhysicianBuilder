#!/usr/bin/env bash
# Zero-PHI pre-commit sanitizer — PhysicianBuilder
# Blocks commits containing patterns that suggest real PHI or internal infrastructure leakage.
# Exit 1 on any hit with an actionable message.
#
# Synthetic whitelist: MRNs/CSNs of exactly 9 digits starting with 999 (e.g. 999000123)
# are the mandated synthetic form and pass; everything else 9+ digits is flagged.
set -euo pipefail

# Exclude the sanitizer itself (its detector literals would self-match).
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(png|jpg|jpeg|gif|ico|pdf)$' | grep -vE '^\.githooks/' || true)
[ -z "$staged" ] && exit 0

fail=0

scan() {
  local label="$1"; local regex="$2"
  local hits
  hits=$(echo "$staged" | xargs grep -nE "$regex" 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "PRE-COMMIT SANITIZER: $label"
    echo "$hits"
    echo
    fail=1
  fi
}

# --- PHI patterns ---
# MRN/CSN: any run of 9+ digits, minus the synthetic 999-prefixed exactly-9 form
scan_mrns() {
  local hits
  hits=$(echo "$staged" | xargs grep -HnoE '[0-9]{9,}' 2>/dev/null | while IFS=: read -r file line num; do
    if [ "${#num}" -eq 9 ] && [ "${num:0:3}" = "999" ]; then
      :  # synthetic whitelist
    else
      echo "$file:$line:$num"
    fi
  done || true)
  if [ -n "$hits" ]; then
    echo "PRE-COMMIT SANITIZER: possible real MRN/CSN (9+ digit run, non-synthetic)"
    echo "$hits"
    echo
    fail=1
  fi
}
scan_mrns

# DOB patterns
scan "possible DOB (MM/DD/YYYY 19xx)" \
  '(0[1-9]|1[0-2])/(0[1-9]|[12][0-9]|3[01])/19[0-9]{2}'

# SSN
scan "possible SSN" \
  '(^|[^0-9])[0-9]{3}-[0-9]{2}-[0-9]{4}([^0-9]|$)'

# --- Infrastructure leakage ---
scan "private IP address" \
  '(^|[^0-9])(10\.[0-9.]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9.]+|192\.[0-9.]+)\.[0-9]{1,3}([^0-9]|$)'

scan "internal domain / intranet URL" \
  '(peacehealth\.(org|local|intranet)|phm\.(org|local))'

scan "credential / token / private key" \
  '(AKIA[0-9A-Z]{16}|aws_secret_access_key|BEGIN [A-Z ]*PRIVATE KEY|Bearer [A-Za-z0-9._-]{20,}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-)'

if [ "$fail" -eq 1 ]; then
  echo
  echo "BLOCKED: commit contains potential PHI or internal-infrastructure leakage."
  echo "Scrub to synthetic form (MRN 999xxxxxx, <server>, TEST-DOE, JOHN) and re-stage."
  echo "Bypass only with a documented reason:  git commit --no-verify  (record it in SESSION_LOG.md)"
  exit 1
fi

echo "pre-commit: zero-PHI sanitizer passed"
exit 0
